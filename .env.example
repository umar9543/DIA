# Copy to .env next to docker-compose.yml, then: docker compose up -d --build
# Never commit the real .env.

# SQL Server 'sa' password. Must be 8+ chars with upper, lower, digit and symbol or SQL Server refuses to start.
DB_PASSWORD=ChangeMe_Str0ng!Pass
DB_NAME=dia_db

# Long random string; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Host port the API is published on (local/dev only; in production Caddy fronts the API)
API_PORT=5000

# --- Production only (docker-compose.prod.yml) ---
# Public hostnames; DNS A records for both must point at the server before starting.
API_DOMAIN=api.example.de
APP_DOMAIN=app.example.de
# Origin the browser app is served from; the API only accepts requests from here.
FRONTEND_ORIGIN=https://app.example.de
