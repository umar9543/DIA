PORT=5000
JWT_SECRET=supersecretjwtkey_change_in_production

# MS SQL Server Configuration
# Fill in your own database details here!
DB_USER=sa
DB_PASSWORD=pwd
DB_SERVER=localhost
DB_NAME=dia_db

# Note: DB_PORT is typically 1433 for SQL Server
DB_PORT=1433

# TLS to the database. Set DB_ENCRYPT=true for Azure SQL / hosted servers with a valid cert,
# and DB_TRUST_CERT=false once the server certificate is trusted.
DB_ENCRYPT=false
DB_TRUST_CERT=true
